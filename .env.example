# Copy into Vercel > Project > Settings > Environment Variables (or a local .env file).
# PUBLIC values only. Never add a service_role / sb_secret_ key: it would be shipped to every visitor.
# (NEXT_PUBLIC_* names also work, so an existing setup does not need renaming.)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp number for orders: country code + number, digits only (India example)
VITE_WHATSAPP_NUMBER=919876543210

# Optional social links (icons are hidden when empty)
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=
VITE_LINKEDIN_URL=

# WhatsApp promotional automation (Meta Cloud API): these are server-side
# secrets for the Supabase Edge Functions, NOT Vite/frontend variables - do
# NOT add a VITE_ prefix or put them here. Set them with
# `supabase secrets set NAME=value`; see supabase/functions/README.md.
#   META_WHATSAPP_TOKEN
#   META_PHONE_NUMBER_ID
#   META_WABA_ID
#   META_WEBHOOK_VERIFY_TOKEN
#   META_APP_SECRET
