# Copy these into Vercel > Project > Settings > Environment Variables
# (or into a local .env file and run: node scripts/build-config.js).
# Only PUBLIC values. Never add a service_role / sb_secret_ key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp number for orders: country code + number, digits only (India example)
WHATSAPP_NUMBER=919876543210
